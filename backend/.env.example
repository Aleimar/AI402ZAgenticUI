# Copy this file to ".env" (same folder) and fill it in. Never commit .env!

# ----------------------------------------------------------------------------
# 1. The LLM
# ----------------------------------------------------------------------------
# Default: Google Gemini. Create a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL=gemini-3.8-flash

# Want another provider? Write MODEL as "provider/model" and add that provider's
# key. ADK then goes through LiteLLM (see step 7 of the tutorial). Examples:
#
# MODEL=openai/gpt-5.4-mini
# OPENAI_API_KEY=
#
# MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
#
# MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=
#
# MODEL=ollama_chat/mistral-small3.1        (a model running on your own computer)
# OLLAMA_API_BASE=http://localhost:11434

# ----------------------------------------------------------------------------
# 2. Tracing with Arize Phoenix (optional, see step 8 of the tutorial)
# ----------------------------------------------------------------------------
# Remove the "#" below AFTER you have started Phoenix with: uv run phoenix serve
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=agentic-ui-tutorial

# ----------------------------------------------------------------------------
# 3. Server port (optional). If you change it, also set AGENT_URL in frontend/.env.local
# ----------------------------------------------------------------------------
# PORT=8000
